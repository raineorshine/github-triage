{
  "name": "github-triage",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3100",
    "dev:install": "scripts/dev-service.sh install",
    "dev:uninstall": "scripts/dev-service.sh uninstall",
    "dev:start": "scripts/dev-service.sh start",
    "dev:stop": "scripts/dev-service.sh stop",
    "dev:restart": "scripts/dev-service.sh restart",
    "dev:status": "scripts/dev-service.sh status",
    "dev:logs": "scripts/dev-service.sh logs",
    "build": "next build",
    "start": "next start -p 3100",
    "typecheck": "tsc --noEmit",
    "lint": "eslint",
    "test": "node --test \"src/lib/*.test.ts\"",
    "auto-done:install": "scripts/auto-done-service.sh install",
    "auto-done:uninstall": "scripts/auto-done-service.sh uninstall",
    "auto-done:start": "scripts/auto-done-service.sh start",
    "auto-done:stop": "scripts/auto-done-service.sh stop",
    "auto-done:status": "scripts/auto-done-service.sh status",
    "auto-done:run": "scripts/auto-done-service.sh run",
    "auto-done:logs": "scripts/auto-done-service.sh logs"
  },
  "dependencies": {
    "@primer/octicons-react": "^19.35.0",
    "next": "16.3.4",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.4",
    "typescript": "^5"
  },
  "license": "MIT"
}
